# Copy to .env and fill in. Never commit .env.

# NVIDIA Build (Nemotron fallback) - https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Verda inference (Nemotron endpoint): from Inference -> Models
VERDA_API_KEY=
VERDA_NEMOTRON_BASE_URL=
VERDA_NEMOTRON_MODEL=
# Verda cloud API (batch jobs, GPU instances, containers): Client ID + Secret
VERDA_CLIENT_ID=
VERDA_CLIENT_SECRET=

# Modal: auth via `modal token new` (stored in ~/.modal.toml, not here)

# Gemma
HF_TOKEN=
GEMMA_MODEL=google/gemma-3-4b-it

# Aiven Postgres + pgvector
DATABASE_URL=

# Cloudinary
CLOUDINARY_URL=

# Gemini (tier 3)
GEMINI_API_KEY=

# ElevenLabs (tier 3)
ELEVENLABS_API_KEY=
OPENROUTER_API_KEY=
# self-hosted Nemotron (vLLM on a Verda GPU)
NEMOTRON_SELF_BASE_URL=
NEMOTRON_SELF_API_KEY=
NEMOTRON_SELF_MODEL=nemotron-3.5-super-vl
