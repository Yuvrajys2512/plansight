# Copy to .env and fill in. Never commit .env.

# NVIDIA Build (Nemotron fallback) - https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NEMOTRON_MODEL=

# Verda (Nemotron endpoint + compute)
VERDA_API_KEY=
VERDA_NEMOTRON_BASE_URL=

# Modal: auth via `modal token new` (stored in ~/.modal.toml, not here)

# Gemma
HF_TOKEN=
GEMMA_MODEL=

# Aiven Postgres + pgvector
DATABASE_URL=

# Cloudinary
CLOUDINARY_URL=

# Gemini (tier 3)
GEMINI_API_KEY=

# ElevenLabs (tier 3)
ELEVENLABS_API_KEY=
